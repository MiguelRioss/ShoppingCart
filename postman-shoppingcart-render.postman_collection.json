    {
      "name": "Create checkout - current cart",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"successUrl\": \"https://example.com/success\",\n  \"cancelUrl\": \"https://example.com/cancel\",\n  \"customerEmail\": \"{{email}}\",\n  \"shippingCharge\": null\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "checkout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('checkout endpoint responds', function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([201, 400, 500]);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "  const body = pm.response.json();",
              "  pm.test('checkout session is returned', function () {",
              "    pm.expect(body).to.have.property('id');",
              "    pm.expect(body).to.have.property('provider', 'stripe');",
              "    pm.expect(body).to.have.property('url');",
              "  });",
              "  pm.collectionVariables.set('checkoutUrl', body.url || '');",
              "}"
            ]
          }
        }
      ]
    },
