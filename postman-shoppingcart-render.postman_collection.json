    {
      "name": "Create cart - session product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"products\": [\n    {\n      \"productId\": {{productId}},\n      \"quantityM2\": 0.5\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "cart"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('creates a session cart', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('cart stores the session id and product', function () {",
              "  pm.expect(body.sessionId).to.eql(pm.collectionVariables.get('sessionId'));",
              "  pm.expect(body.products).to.be.an('array').with.lengthOf(1);",
              "  pm.expect(body.products[0].productId).to.eql(Number(pm.collectionVariables.get('productId')));",
              "  pm.expect(body.products[0].squareMeters).to.eql(0.5);",
              "});"
            ]
          }
        }
      ]
    },
