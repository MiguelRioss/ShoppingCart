    {
      "name": "Auth status - bearer token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "status"
          ]
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 for a valid bearer token', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('auth status confirms authenticated user', function () {",
              "  pm.expect(body).to.have.property('authenticated', true);",
              "  pm.expect(body).to.have.property('userId');",
              "  pm.expect(body).to.have.property('email', pm.collectionVariables.get('email').toLowerCase());",
              "});"
            ]
          }
        }
      ]
