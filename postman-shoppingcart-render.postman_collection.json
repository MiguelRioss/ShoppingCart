{
  "info": {
    "name": "ShoppingCart API",
    "description": "Postman tests for the current ShoppingCart API: auth, account, products, cart, checkout, and error routes.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://shoppingcart-4ohf.onrender.com"
    },
    {
      "key": "email",
      "value": ""
    },
    {
      "key": "password",
      "value": "password-123"
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
