  {
    "info": {
      "name": "ShoppingCart — complete Stripe test customer journey",
      "description": "Create a fresh customer, log in, check auth, buy a real product, inspect payment and email history, then delete only the created test account. Pause after Checkout to pay on Stripe's hosted page; Postman cannot complete that page or forge a paid webhook.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      { "key": "shoppingCartBaseUrl", "value": "http://localhost:8080" },
      { "key": "emailSenderBaseUrl", "value": "http://localhost:3002" },
      { "key": "sessionId", "value": "" },
      { "key": "productId", "value": "9091" },
      { "key": "quantityM2", "value": "0.5" },
      { "key": "successUrl", "value": "https://example.com/success" },
      { "key": "cancelUrl", "value": "https://example.com/cancel" },
      { "key": "checkoutSessionId", "value": "" },
      { "key": "orderId", "value": "" },
      { "key": "checkoutUrl", "value": "" },
      { "key": "createdUserId", "value": "" },
      { "key": "paymentVerified", "value": "false" }
    ],
    "item": [
      {
        "name": "1. Register fresh test customer",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": "{{shoppingCartBaseUrl}}/register",
          "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Test\",\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"phone\": \"+351 912 345 678\",\n  \"customerType\": \"private_customer\",\n  \"deliveryAddress\": {\n    \"addressLine1\": \"Rua de Teste 1\",\n    \"townOrCity\": \"Lisboa\",\n    \"postcode\": \"1000-001\",\n    \"country\": \"Portugal\"\n  },\n  \"sameAsDeliveryAddress\": true,\n  \"sessionId\": \"{{sessionId}}\"\n}", "options": { "raw": { "language": "json" } } },
          "description": "Set testInboxEmail in a local Postman environment. The script generates a unique plus-address, password and cart session for every run. The mailbox must support plus-addressing."
        },
        "event": [
          { "listen": "prerequest", "script": { "exec": [
            "const inbox = pm.environment.get('testInboxEmail');",
            "if (!inbox || !inbox.includes('@')) throw new Error('Set testInboxEmail in a local Postman environment');",
            "const runId = pm.variables.replaceIn('{{$guid}}').replace(/-/g, '').slice(0, 12);",
            "const at = inbox.lastIndexOf('@');",
            "pm.environment.set('customerEmail', inbox.slice(0, at) + '+checkout-' + runId + inbox.slice(at));",
            "pm.environment.set('customerPassword', 'PostmanTest!' + runId);",
            "pm.collectionVariables.set('sessionId', 'postman-' + runId);",
            "pm.collectionVariables.set('createdUserId', '');",
            "pm.collectionVariables.set('checkoutSessionId', '');",
            "pm.collectionVariables.set('orderId', '');",
            "pm.collectionVariables.set('paymentVerified', 'false');"
          ], "type": "text/javascript" } },
          { "listen": "test", "script": { "exec": [
            "pm.test('Test customer registered', () => pm.response.to.have.status(201));",
            "if (pm.response.code === 201) {",
            "  const body = pm.response.json();",
            "  pm.collectionVariables.set('createdUserId', body.userId);",
            "  pm.environment.set('authToken', body.token);",
            "  pm.test('New user and token returned', () => { pm.expect(body.userId).to.be.a('string').and.not.empty; pm.expect(body.token).to.be.a('string').and.not.empty; });",
            "}"
          ], "type": "text/javascript" } }
        ]
      },
      {
        "name": "2. Login as new customer",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": "{{shoppingCartBaseUrl}}/login",
          "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\",\n  \"sessionId\": \"{{sessionId}}\"\n}", "options": { "raw": { "language": "json" } } },
          "description": "Signs in with the account created in request 1."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Login succeeds', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) {",
          "  const body = pm.response.json();",
          "  pm.environment.set('authToken', body.token);",
          "  pm.test('Logged in as newly created user', () => pm.expect(body.userId).to.eql(pm.collectionVariables.get('createdUserId')));",
          "  pm.test('Bearer token returned', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
          "}"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "3. Verify logged-in user",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
          "url": "{{shoppingCartBaseUrl}}/auth/status"
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Authentication status returned', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) {",
          "  const body = pm.response.json();",
          "  pm.test('Correct test user is authenticated', () => { pm.expect(body.authenticated).to.be.true; pm.expect(body.userId).to.eql(pm.collectionVariables.get('createdUserId')); pm.expect(body.email).to.eql(pm.environment.get('customerEmail').toLowerCase()); });",
          "}"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "4. Verify real product",
        "request": {
          "method": "GET",
          "url": "{{shoppingCartBaseUrl}}/products/{{productId}}",
          "description": "Confirms the selected live catalogue product exists before building the cart."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Product returned', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) pm.test('Selected product matches', () => pm.expect(Number(pm.response.json().id)).to.eql(Number(pm.collectionVariables.get('productId'))));"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "5. Save test cart",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Authorization", "value": "Bearer {{authToken}}" }
          ],
          "url": "{{shoppingCartBaseUrl}}/cart",
          "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"products\": [{\"productId\": {{productId}}, \"quantityM2\": {{quantityM2}}}]\n}", "options": { "raw": { "language": "json" } } },
          "description": "Uses the unique session created in request 1 and the product verified in request 4."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Cart saved', () => pm.response.to.have.status(201));",
          "if (pm.response.code === 201) pm.test('Cart belongs to this session', () => pm.expect(pm.response.json().sessionId).to.eql(pm.collectionVariables.get('sessionId')));"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "6. Create Stripe test Checkout",
        "request": {
          "method": "POST",
          "header": [
            { "key": "Content-Type", "value": "application/json" },
            { "key": "Authorization", "value": "Bearer {{authToken}}" }
          ],
          "url": "{{shoppingCartBaseUrl}}/checkout",
          "body": { "mode": "raw", "raw": "{\n  \"sessionId\": \"{{sessionId}}\",\n  \"successUrl\": \"{{successUrl}}\",\n  \"cancelUrl\": \"{{cancelUrl}}\"\n}", "options": { "raw": { "language": "json" } } },
          "description": "The API uses the authenticated account's delivery address and calculates shipping. Open the returned checkoutUrl in a browser and pay with a Stripe test card. The success redirect alone does not mark the order PAID."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Checkout created', () => pm.response.to.have.status(201));",
          "if (pm.response.code === 201) {",
          "  const body = pm.response.json();",
          "  pm.collectionVariables.set('checkoutSessionId', body.id);",
          "  pm.collectionVariables.set('checkoutUrl', body.url);",
          "  pm.test('Stripe test checkout URL returned', () => { pm.expect(body.id.startsWith('cs_test_')).to.be.true; pm.expect(body.url.startsWith('https://checkout.stripe.com/')).to.be.true; });",
          "}"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "7. Check order after payment",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
          "url": "{{shoppingCartBaseUrl}}/orders",
          "description": "Run after completing the Stripe hosted payment and allowing the webhook to arrive. The matching order must be PAID; a redirect alone is insufficient."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Orders returned', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) {",
          "  const order = pm.response.json().orders.find(item => item.checkoutSessionId === pm.collectionVariables.get('checkoutSessionId'));",
          "  pm.test('Matching order found', () => pm.expect(order).to.exist);",
          "  if (order) {",
          "    pm.collectionVariables.set('orderId', order.id);",
          "    pm.test('Payment confirmed by webhook', () => pm.expect(order.status).to.eql('PAID'));",
          "    pm.collectionVariables.set('paymentVerified', String(order.status === 'PAID'));",
          "    pm.test('Paid amount and currency recorded', () => { pm.expect(Number(order.amountPaidMinor)).to.be.above(0); pm.expect(order.paidCurrency).to.eql('eur'); });",
          "    const snapshot = order.snapshot || {};",
          "    pm.test('Saved paid total matches Stripe paid amount', () => { const expected = Math.round(Number(snapshot.total || 0) * 100); pm.expect(Number(order.amountPaidMinor)).to.be.at.least(expected); });",
          "  }",
          "}"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "8. Check order-confirmation email history",
        "request": {
          "method": "GET",
          "header": [{ "key": "Authorization", "value": "Bearer {{emailSenderApiKey}}" }],
          "url": "{{emailSenderBaseUrl}}/v2/emails?orderReference={{orderId}}",
          "description": "Use the same EMAIL_SENDER_API_KEY configured on both services. The history should contain an order-confirmation delivery; SMTP acceptance does not prove inbox placement."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Email history returned', () => pm.response.to.have.status(200));",
          "if (pm.response.code === 200) {",
          "  const body = pm.response.json();",
          "  const entries = Array.isArray(body) ? body : (body.emails || body.deliveries || []);",
          "  const confirmation = entries.find(item => (item.templateId || item.template_id) === 'order-confirmation');",
          "  pm.test('Order confirmation recorded', () => pm.expect(confirmation, JSON.stringify(body)).to.exist);",
          "  if (!confirmation) console.error('No confirmation delivery record. Inspect Stripe webhook response and ShoppingCart logs for PDF/email failure.');",
          "}"
        ], "type": "text/javascript" } }]
      },
      {
        "name": "9. Delete created test user",
        "request": {
          "method": "DELETE",
          "header": [{ "key": "Authorization", "value": "Bearer {{authToken}}" }],
          "url": "{{shoppingCartBaseUrl}}/account",
          "description": "Deletes only the test account created by request 1, after request 7 confirms payment. Paid order and email records may remain for audit."
        },
        "event": [
          { "listen": "prerequest", "script": { "exec": [
            "if (pm.collectionVariables.get('paymentVerified') !== 'true') throw new Error('Do not delete before the paid order is verified');",
            "if (!pm.collectionVariables.get('createdUserId')) throw new Error('No user created by this run');"
          ], "type": "text/javascript" } },
          { "listen": "test", "script": { "exec": [
            "pm.test('Created test user deleted', () => pm.response.to.have.status(200));",
            "if (pm.response.code === 200) pm.environment.unset('authToken');"
          ], "type": "text/javascript" } }
        ]
      },
      {
        "name": "10. Verify deleted user cannot log in",
        "request": {
          "method": "POST",
          "header": [{ "key": "Content-Type", "value": "application/json" }],
          "url": "{{shoppingCartBaseUrl}}/login",
          "body": { "mode": "raw", "raw": "{\"email\":\"{{customerEmail}}\",\"password\":\"{{customerPassword}}\"}", "options": { "raw": { "language": "json" } } },
          "description": "Use the same generated credentials to verify deletion. The password remains in the local environment until this check completes."
        },
        "event": [{ "listen": "test", "script": { "exec": [
          "pm.test('Deleted user cannot log in', () => pm.response.to.have.status(401));",
          "pm.environment.unset('authToken');",
          "pm.environment.unset('customerPassword');"
        ], "type": "text/javascript" } }]
      }
    ]
  }
